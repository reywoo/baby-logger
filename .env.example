# Gemini API Key (Required for multimodal audio processing)
GEMINI_API_KEY=your_gemini_api_key_here

# Port configuration
PORT=3000


# PostgreSQL Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=family_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

# JWT Authentication Secret
JWT_SECRET=family_assistant_jwt_secret_key_2026_super_secure

# Google OAuth Client ID (Get from Google Cloud Console for Google Sign-in)
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Maximum Google OAuth accounts allowed in the system (default: 10)
MAX_GOOGLE_ACCOUNTS=10

